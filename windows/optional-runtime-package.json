      "realWindowsInferenceVerified": false,
      "status": "dependency wheels pinned; original RoFormer checkpoint terms unresolved; no inference authorization",
      "acceptance": "10 s synthetic stereo harmonic/percussive input, local-only Vocals/Instrumental nonempty finite FLAC, expected channels/rate/duration, recompose mixture/inspect clipping; log timing/VRAM/RAM; no quality claim on real music"
    },
    "stems-four": {
      "implementation": "lab/stems_job.py; RoFormer first, Demucs htdemucs_ft on instrumental",
