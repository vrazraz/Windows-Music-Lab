      "resourceGateAtSuppliedSnapshot": "passes",
      "realWindowsInferenceVerified": false,
      "status": "same RoFormer licence hold; four original Meta weights pinned",
      "acceptance": "same 10 s synthetic input; Vocals/Drums/Bass/Other files and metadata verified; verify actual native model execution not mocked resolver"
    },
    "creator-transcriber": {
      "implementation": "existing windows/build/full-engine/yue-server.exe --transcriber models/SheetSage2-Q8_0.gguf; /transcribe",
      "environment": "existing native engine",
      "newPythonDependencies": [],
      "gpuGateMiB": null,
      "resourceGateAtSuppliedSnapshot": "unmeasured native 300-second fixed window; root-owned exclusive lease/headroom required",
      "realWindowsInferenceVerified": false,
      "status": "one converted GGUF pinned; NC licence; no separate yue-transcribe.exe currently found",
      "acceptance": "one short synthetic musical recording through local /transcribe, parse ABC event/tempo/notes and MIDI export if supported; preserve log; 300 s padded input means short audio does not prove small memory"
    },
    "audio-upscale": {
      "implementation": "lab/upscale_job.py; UniverSR.from_pretrained(existing local directory), soundfile/tensor path",
      "environment": "core",
      "gpuGateMiB": 11000,
      "currentAdmittedFreeMiB": 10078,
      "resourceGateAtSuppliedSnapshot": "blocked",
      "idleCardPossibleFit": "12288-512=11776 MiB theoretical total; empty_fits special case requires no foreign GPU processes and current free>=11264, unvalidated here",
      "realWindowsInferenceVerified": false,
      "status": "source review/local wheel packaging pending; model metadata pinned; no running until unchanged guard grants 11000",
      "acceptance": "only after all guards: one 2-5 s band-limited synthetic clip, mode subtle, single seed, one channel then short stereo; output 48k finite duration, logs/peak; 20 s production chunk remains unvalidated; do not lower guard based on theory"
    },
    "image-upscale": {
      "implementation": "lab/artist_upscale.py; spandrel ModelLoader; 512 tile overlap32; official RealESRGAN_x4plus RRDBNet",
      "environment": "art",
      "gpuGateMiB": 4000,
      "currentAdmittedFreeMiB": 10078,
      "resourceGateAtSuppliedSnapshot": "passes",
      "realWindowsInferenceVerified": false,
      "status": "two new pure wheels; original model URL with pinned secondary metadata digest; restricted unpickling requires audit",
      "acceptance": "one 256x256 synthetic raster ->1024x1024 PNG, finite RGB/channels, log loader architecture/scale/VRAM; then optionally existing local frame if still in scope"
    },
